@{
    var account = ViewBag.Account as Bank_System.Models.BankAccount;
    ViewData["Title"] = "Зняття коштів";
}

<div class="container my-4" style="max-width: 500px;">
    <h3>Зняття коштів</h3>
    <p class="text-muted">Рахунок: <strong>@account?.AccountNumber</strong> | Доступно: <strong>@account?.Balance.ToString("N2") @account?.Currency</strong></p>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Withdraw" method="post">
        <input type="hidden" name="id" value="@account?.Id" />

        <div class="mb-3">
            <label class="form-label">Сума зняття:</label>
            <input type="number" step="0.01" name="amount" class="form-control" required min="0.01" />
        </div>

        <div class="mb-3">
            <label class="form-label">Опис:</label>
            <input type="text" name="description" class="form-control" placeholder="Наприклад: Зняття готівки в банкоматі" />
        </div>

        <button type="submit" class="btn btn-danger w-100">Зняти кошти</button>
        <a asp-action="Details" asp-route-id="@account?.Id" class="btn btn-link w-100 mt-2">Скасувати</a>
    </form>
</div>