@{
    var account = ViewBag.Account as Bank_System.Models.BankAccount;
    ViewData["Title"] = "Поповнення";
}

<div class="container my-4" style="max-width: 500px;">
    <h3>Поповнення рахунку</h3>
    <p class="text-muted">Рахунок: <strong>@account?.AccountNumber</strong></p>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Deposit" method="post">
        <input type="hidden" name="id" value="@account?.Id" />

        <div class="mb-3">
            <label class="form-label">Сума поповнення:</label>
            <input type="number" step="0.01" name="amount" class="form-control" required min="0.01" />
        </div>

        <div class="mb-3">
            <label class="form-label">Опис:</label>
            <input type="text" name="description" class="form-control" placeholder="Наприклад: Поповнення через термінал" />
        </div>

        <button type="submit" class="btn btn-success w-100">Поповнити</button>
        <a asp-action="Details" asp-route-id="@account?.Id" class="btn btn-link w-100 mt-2">Скасувати</a>
    </form>
</div>